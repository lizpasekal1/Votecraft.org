{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "manifest.json",
      "Documentation/**",
      "scripts/**",
      "rules/**",
      "_metadata/**",
      "src/background/**",
      "src/content/**",
      "src/popup/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/src/app/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
        ]
      },
      {
        "source": "/src/app/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
        ]
      },
      {
        "source": "/src/sponsored/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
        ]
      }
    ]
  }
}
