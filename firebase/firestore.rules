rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // JokeMaster
    // -----------------------------------------------------------------------

    // Game state — each user can only read/write their own document
    match /gameStates/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Joke votes — keyed as {userId}_{jokeId}
    match /jokeVotes/{voteId} {
      allow read, write: if request.auth != null &&
                           voteId.matches('^' + request.auth.uid + '_.*');
    }

    // -----------------------------------------------------------------------
    // SaveCraft — curated library (public read, admin-console write only)
    // -----------------------------------------------------------------------

    match /curated_items/{doc} {
      allow read:  if true;
      allow write: if false;  // edit via Firebase console only
    }

    match /curated_genres/{doc} {
      allow read:  if true;
      allow write: if false;  // edit via Firebase console only
    }

    // -----------------------------------------------------------------------
    // SaveCraft — per-user synced library (auth-gated, mirrors gameStates)
    // -----------------------------------------------------------------------

    match /savecraft_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /folders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /authors/{authorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -----------------------------------------------------------------------
    // SaveCraft — Admin Kanban board (shared, not per-user). Mirrors utils.js's
    // isAdminUser(email, role) exactly — a hardcoded email allowlist OR a
    // role:'admin' field on the requester's own savecraft_users/{uid} doc —
    // plus one hardcoded UID for the WordPress plugin's dedicated bot account
    // (wp-savecraft-bot@votecraft-789.internal), which has no email in that
    // allowlist and no savecraft_users doc of its own. Deliberately NOT a
    // static human-UID allowlist: that would've meant hardcoding Liz's own
    // account UID here too (and every future admin's), and silently going
    // stale the moment ADMIN_EMAILS changes on the JS side without a matching
    // rules edit. The bot's credential (a refresh token, not this UID itself)
    // is the only thing that ever needs to live inside WordPress, and this
    // rule is the entirety of what that credential can touch: nothing under
    // savecraft_users, no writes to curated_items, no account listing (that's
    // a separate system — see Documentation/launch-requirements.md's Phase 2
    // note in Savecraft).
    match /admin_kanban_cards/{cardId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == 'cS6j7sw1yBORiI7SIat8SN32QBy2' ||
        request.auth.token.email.lower() in ['lizpasekal@gmail.com'] ||
        get(/databases/$(database)/documents/savecraft_users/$(request.auth.uid)).data.role == 'admin'
      );
    }

  }
}
